        "uid": "prometheus-korp"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FORA DO AR",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "NO AR",
                  "color": "green",
                  "index": 1
                }
              }

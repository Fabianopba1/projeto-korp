            "uid": "prometheus-korp"
          },
          "editorMode": "code",
          "expr": "sum(rate(korp_http_requests_total{status=~\"2..|3..\"}[5m])) / clamp_min(sum(rate(korp_http_requests_total[5m])), 0.0001) * 100",
